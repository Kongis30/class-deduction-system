{
  "name": "class-deduction-desktop",
  "version": "1.0.0",
  "description": "JIN BEST TUTORING - Class Deduction System",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:frontend": "cd ../frontend && npm run build",
    "pack": "ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --dir",
    "dist": "ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder",
    "dist:mac": "ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --mac",
    "dist:win": "ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --win",
    "dist:linux": "ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --linux"
  },
  "build": {
    "appId": "com.jinbesttutoring.class-deduction",
    "productName": "JIN BEST TUTORING",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "frontend-dist",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "target": [
        "zip"
      ],
      "icon": "../frontend/public/logo.jpg",
      "category": "public.app-category.business"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "../frontend/public/logo.jpg"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "../frontend/public/logo.jpg",
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "keywords": [
    "jin-best-tutoring",
    "class-deduction"
  ],
  "author": "JIN BEST TUTORING",
  "license": "UNLICENSED",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1"
  }
}
